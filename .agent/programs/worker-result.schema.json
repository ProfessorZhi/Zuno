{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zuno.local/schemas/worker-result.schema.json",
  "title": "Zuno PHASE22 Claude Worker Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker_task_id",
    "status",
    "summary",
    "changed_files",
    "test_commands",
    "test_results",
    "blockers"
  ],
  "properties": {
    "worker_task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "status": {
      "type": "string",
      "pattern": "^(COMPLETED|REVIEWED_PARTIAL|FAILED_WORKER_COMPLETION|BLOCKED_[A-Z0-9_]+)$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "patch": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "session_correlation": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "required": [
          "commit_sha"
        ],
        "properties": {
          "changed_files": {
            "minItems": 1
          },
          "test_commands": {
            "minItems": 1
          },
          "test_results": {
            "minItems": 1
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "pattern": "^BLOCKED_"
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
